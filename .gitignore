# Секреты и локальные настройки
.env
.env.*
config.local.js
*.pem
*.key

# Данные архива: реальные записи, фотографии и база не хранятся в репозитории
data/archive.json
data/*.local.json
uploads/
backups/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Серверная часть: код доступа к архиву и схема базы публичными не становятся.
# Хранится и доставляется отдельно, на сервере лежит рядом с клиентом.
server/

# Локальные зависимости и сборки
node_modules/
vendor/
dist/

# Служебные файлы окружения и вспомогательных инструментов
.claude/
CLAUDE.md
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Отчёт по UX собран на настоящих записях архива и потому в репозиторий не
# попадает: здесь только код сервиса (см. README, раздел 1). Файл живёт
# локально, а поделиться им можно опубликованной ссылкой на артефакт.
docs/ux-report.html

# Скрипты выполняются на Linux: перевод строки только LF, иначе интерпретатор
# спотыкается о \r в строке #!/usr/bin/env bash после выгрузки с Windows.
*.sh text eol=lf

# Остальные текстовые файлы нормализуются в репозитории, в рабочей копии —
# по настройкам системы.
*.js   text
*.json text
*.html text
*.css  text
*.md   text
